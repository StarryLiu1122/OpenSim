{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Region Lab FP 0.2 snapshot",
  "type": "object",
  "properties": {
    "snapshot_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "coordinate_system": {
      "const": "X-east,Y-north,Z-up;metres"
    },
    "scope": {
      "const": "non-attachment-region-objects-and-root-avatars"
    },
    "entities": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "entity_id": {
                "type": "string",
                "pattern": "^group/"
              },
              "source_id": {
                "type": "string",
                "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "kind": {
                "const": "object_group"
              },
              "root_id": {
                "type": "string",
                "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "owner_id": {
                "type": "string",
                "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "position": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "rotation": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "entity_id": {
                      "type": "string",
                      "pattern": "^part/"
                    },
                    "source_id": {
                      "type": "string",
                      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                    },
                    "name": {
                      "type": "string"
                    },
                    "link_number": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "local_position": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "rotation": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    },
                    "size": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "state": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "entity_id",
                    "source_id",
                    "name",
                    "link_number",
                    "local_position",
                    "rotation",
                    "size",
                    "state"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              }
            },
            "required": [
              "entity_id",
              "source_id",
              "kind",
              "root_id",
              "position",
              "rotation",
              "members"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "entity_id": {
                "type": "string",
                "pattern": "^avatar/"
              },
              "source_id": {
                "type": "string",
                "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "kind": {
                "const": "avatar"
              },
              "position": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "rotation": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "required": [
              "entity_id",
              "source_id",
              "kind",
              "position",
              "rotation"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "consistency": {
      "type": "string"
    }
  },
  "required": [
    "snapshot_seq",
    "coordinate_system",
    "scope",
    "entities",
    "consistency"
  ],
  "additionalProperties": false
}
