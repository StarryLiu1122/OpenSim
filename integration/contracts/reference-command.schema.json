{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:region-lab:reference-command:0.1",
  "title": "V4 experimental reference command; structural validation only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fp_version",
    "request_id",
    "trace_id",
    "world_epoch",
    "operation",
    "expires_at",
    "payload"
  ],
  "properties": {
    "fp_version": {
      "const": "0.1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "world_epoch": {
      "anyOf": [
        {
          "const": ""
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          }
        }
      ]
    },
    "operation": {
      "enum": [
        "GetCapabilities",
        "GetSnapshot",
        "GetReceipt",
        "CreateBox",
        "Link",
        "Move",
        "Rotate",
        "MoveMember",
        "Scale",
        "Duplicate",
        "Unlink",
        "Delete",
        "Backup"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "GetCapabilities"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "GetSnapshot"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "GetReceipt"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "not": {
                  "const": "00000000-0000-0000-0000-000000000000"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "CreateBox"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "position",
              "size"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "size": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 16
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "Link"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root_id",
              "child_id"
            ],
            "properties": {
              "root_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "not": {
                  "const": "00000000-0000-0000-0000-000000000000"
                }
              },
              "child_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "not": {
                  "const": "00000000-0000-0000-0000-000000000000"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "Move"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group_id",
              "position"
            ],
            "properties": {
              "group_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "not": {
                  "const": "00000000-0000-0000-0000-000000000000"
                }
              },
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "Rotate"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group_id",
              "rotation"
            ],
            "properties": {
              "group_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "not": {
                  "const": "00000000-0000-0000-0000-000000000000"
                }
              },
              "rotation": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "MoveMember"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group_id",
              "member_id",
              "local_position"
            ],
            "properties": {
              "group_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "not": {
                  "const": "00000000-0000-0000-0000-000000000000"
                }
              },
              "member_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "not": {
                  "const": "00000000-0000-0000-0000-000000000000"
                }
              },
              "local_position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "Scale"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group_id",
              "factor"
            ],
            "properties": {
              "group_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "not": {
                  "const": "00000000-0000-0000-0000-000000000000"
                }
              },
              "factor": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 4
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "Duplicate"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group_id",
              "offset"
            ],
            "properties": {
              "group_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "not": {
                  "const": "00000000-0000-0000-0000-000000000000"
                }
              },
              "offset": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "Unlink"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group_id"
            ],
            "properties": {
              "group_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "not": {
                  "const": "00000000-0000-0000-0000-000000000000"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "Delete"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group_id"
            ],
            "properties": {
              "group_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                "not": {
                  "const": "00000000-0000-0000-0000-000000000000"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "Backup"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {}
          }
        }
      }
    }
  ]
}
